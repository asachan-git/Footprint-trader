# Required
ANTHROPIC_API_KEY=sk-ant-...

# Live trading tripwire — must be exactly "1" to allow real broker calls.
# config/settings.yaml mode=live alone is NOT sufficient.
ALLOW_LIVE=0

# Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Optional broker credentials (only used when mode=live AND ALLOW_LIVE=1)
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=

# MetaApi.cloud bridge (parked — requires paid balance)
# METAAPI_TOKEN=
# METAAPI_ACCOUNT_ID=
# METAAPI_REGION=new-york

# Capital.com (ACTIVE — India-friendly demo + REST/WS API)
# CAPITAL_API_KEY=
# CAPITAL_IDENTIFIER=
# CAPITAL_PASSWORD=
