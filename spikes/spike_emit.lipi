// FootprintBiot — Phase 0a spike (time format syntax probe)
//
// str.format_time(time, "yyyyMMddHHmmss") → returned literal "yyyyMMddHHmmss" (no substitution)
// str.format_time(time)                  → "No value assigned to `format` parameter"
// → format arg mandatory, but yyyyMMdd pattern not working
//
// Try: different time variable + different format strings
// Uncomment ONE at a time, recompile, check raw_body

//@version=1
indicator("FP time probe", overlay=false)

plot(orderflow.delta, title="delta")

// Candidate 1 — timenow instead of time
ts = str.format_time(timenow, "yyyy-MM-dd HH:mm:ss")
bar_msg = "NQ|1m|" + ts
alert(bar_msg)

